# Copy to .env for LOCAL development only (.env is git-ignored). Never commit real secrets.
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
DATABASE_URL=postgres://user:password@localhost:5432/officepro

# Encrypts the SMTP password stored in the database. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# Optional password for `manage.py seed_pune_company_and_employees` (random one is printed if empty)
SEED_USER_PASSWORD=

# Production (Render) extras
# ALLOWED_HOSTS=office.example.com
# CSRF_TRUSTED_ORIGINS=https://office.example.com
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=3600        # raise to 31536000 once HTTPS is confirmed everywhere
# LOGIN_MAX_FAILURES=5
# LOGIN_LOCKOUT_SECONDS=900
# SESSION_COOKIE_AGE=28800

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
